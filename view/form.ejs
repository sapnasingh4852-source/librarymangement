<!DOCTYPE html>
<html>

<head>
    <title>Add Book</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <h1>Add Book</h1>

    <form action="/createdata" method="POST">

        <input type="text" name="book_name" placeholder="Book_Name"><br><br>

        <input type="text" name="authorName" placeholder="Author Name"><br><br>

        <input type="text" name="category" placeholder="Category"><br><br>

        <input type="String" name="price" placeholder="Price"><br><br>

        <input type="Number" name="Quantity" placeholder="Quantity"><br><br>

        <button type="submit">Save Book</button>

    </form>

</body>

</html>